# ==========================================
# INK & IVORY — PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# Environment Mode: development | test | production
NODE_ENV=development

# Server Port
PORT=3000

# Next.js Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -------------------------------------------------------------
# Database Connection (PostgreSQL + Prisma)
# -------------------------------------------------------------
# Connection string format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public&sslmode=prefer
DATABASE_URL="postgresql://postgres:password@localhost:5432/inkivory?schema=public"

# -------------------------------------------------------------
# Cryptographic Keys & Master Secrets
# -------------------------------------------------------------
# Session & Token Cryptographic HMAC Secret (min 32 characters)
# Generate with: openssl rand -hex 32
SESSION_SECRET="ink_ivory_super_secure_session_secret_change_in_production_32chars"

# Administrative Secret Key (used to authorize /api/admin/login)
# Generate with: openssl rand -hex 32
ADMIN_SECRET_KEY="ink_ivory_admin_key_replace_with_high_entropy_secret_2026"

# -------------------------------------------------------------
# Trusted Proxy & IP Extraction Policy (SEC-S2-001)
# -------------------------------------------------------------
# Values: cloudflare | vercel | reverse-proxy | auto | none
TRUSTED_PROXY_TYPE="auto"

# Optional shared proxy secret if using custom NGINX/Envoy reverse proxy
# TRUSTED_PROXY_SECRET="your_shared_reverse_proxy_header_secret"

# Development-only bypass to test IP header handling (FALSE in production)
ALLOW_UNTRUSTED_FORWARDED_IP="false"

# -------------------------------------------------------------
# Distributed Rate Limiting (Upstash Redis) (SEC-S2-002)
# -------------------------------------------------------------
# Retrieve from https://console.upstash.com/
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"

# -------------------------------------------------------------
# Razorpay Payment Gateway Credentials
# -------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Development mock payment bypass flag (MUST BE FALSE IN PRODUCTION)
ALLOW_DEV_PAYMENT_MOCK="false"

# -------------------------------------------------------------
# Media Storage (Cloudinary Direct Signed Uploads)
# -------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="ink-and-ivory"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
