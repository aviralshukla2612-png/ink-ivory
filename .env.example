# ==============================================================================
# YOU ARE MINE — PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local (development) or configure via your host's secure
# environment secrets manager (Vercel, AWS ECS, GCP Cloud Run, Docker).
# NEVER commit real production secrets, API keys, or private keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
# Environment Mode: development | test | production
NODE_ENV="production"

# Port (used for standalone Node.js server)
PORT=3000

# Canonical Public Web Domain (HTTPS required in production)
# Example: https://www.youaremine.online or https://youaremine.online
NEXT_PUBLIC_APP_URL="https://youaremine.online"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# PostgreSQL Connection String with connection pool parameters
# For Neon / Supabase / AWS RDS: include pgbouncer / pooled connection where possible
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:REPLACE_WITH_STRONG_PASSWORD@db.youaremine.internal:5432/youaremine_prod?schema=public&sslmode=require"

# Direct URL for Prisma migrations (if using PgBouncer pool above)
# DIRECT_URL="postgresql://postgres:REPLACE_WITH_STRONG_PASSWORD@db.youaremine.internal:5432/youaremine_prod?schema=public&sslmode=require"

# ------------------------------------------------------------------------------
# 3. CRYPTOGRAPHIC KEYS & SECRETS
# ------------------------------------------------------------------------------
# Session HMAC & Guest Token Encryption Secret (minimum 32 random characters)
# Generate with: openssl rand -hex 32
SESSION_SECRET="REPLACE_WITH_OPENSSL_GENERATED_64_HEX_CHAR_SECRET_KEY"

# Administrative Access Key (used to authorize admin endpoints & /admin login)
# Generate with: openssl rand -hex 32
ADMIN_SECRET_KEY="REPLACE_WITH_OPENSSL_GENERATED_64_HEX_ADMIN_SECRET_KEY"

# Dedicated Cron Secret for automated payment recovery (/api/payments/recovery)
# Timing-safe verified via Bearer header or x-cron-secret
# Generate with: openssl rand -hex 32
CRON_SECRET="REPLACE_WITH_OPENSSL_GENERATED_64_HEX_CRON_SECRET_KEY"

# ------------------------------------------------------------------------------
# 4. NETWORK & REVERSE PROXY SECURITY
# ------------------------------------------------------------------------------
# Values: cloudflare | vercel | reverse-proxy | auto | none
TRUSTED_PROXY_TYPE="auto"

# Optional shared proxy secret if using custom NGINX/Envoy reverse proxy
# TRUSTED_PROXY_SECRET="REPLACE_WITH_SHARED_PROXY_SECRET"

# Development-only bypass to test IP header handling (STRICTLY false in production)
ALLOW_UNTRUSTED_FORWARDED_IP="false"

# ------------------------------------------------------------------------------
# 5. DISTRIBUTED RATE LIMITING (Upstash Redis)
# ------------------------------------------------------------------------------
# Optional in single-node dev; REQUIRED in multi-instance production for distributed rate-limiting
# Retrieve from https://console.upstash.com/
UPSTASH_REDIS_REST_URL="https://REPLACE_WITH_UPSTASH_CLUSTER.upstash.io"
UPSTASH_REDIS_REST_TOKEN="REPLACE_WITH_UPSTASH_REST_TOKEN"

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAYS
# ------------------------------------------------------------------------------
# Razorpay Credentials (Web & Android Direct APK)
# Test keys begin with rzp_test_, Production keys begin with rzp_live_
RAZORPAY_KEY_ID="rzp_live_REPLACE_WITH_LIVE_KEY_ID"
RAZORPAY_KEY_SECRET="REPLACE_WITH_LIVE_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="REPLACE_WITH_LIVE_WEBHOOK_SECRET"

# Mock payment bypass flag (STRICTLY false in production)
ALLOW_DEV_PAYMENT_MOCK="false"

# Google Play Billing Server Verification (Android Play Store Channel)
# Service Account JSON key string (Base64-encoded) or file path
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
GOOGLE_PLAY_PACKAGE_NAME="com.youaremine.app"

# Apple StoreKit 2 Server Verification (iOS App Store Channel)
# App Store Server API credentials
APPLE_STOREKIT_KEY_ID=""
APPLE_STOREKIT_ISSUER_ID=""
APPLE_STOREKIT_BUNDLE_ID="com.youaremine.app"
APPLE_STOREKIT_PRIVATE_KEY=""
APPLE_STOREKIT_ENVIRONMENT="Production"

# ------------------------------------------------------------------------------
# 7. MEDIA STORAGE & ASSET MANAGEMENT (Cloudinary)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="you-are-mine"
CLOUDINARY_API_KEY="REPLACE_WITH_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="REPLACE_WITH_CLOUDINARY_API_SECRET"

# ------------------------------------------------------------------------------
# 8. TRAI DLT SMS GATEWAY (India Customer Notifications)
# ------------------------------------------------------------------------------
DLT_SMS_URI="https://allsmssolution.in/sms-panel/api/http/index.php"
DLT_USERNAME="EMPEROR"
DLT_APIKEY="REPLACE_WITH_SECURE_DLT_API_KEY"
DLT_SENDER_ID="TXXTOO"
DLT_TEMPLATE_ID="1607100000000313742"
DLT_ENTITY_ID="1401805350000060162"
DLT_ROUTE="TRANS"

# ------------------------------------------------------------------------------
# 9. OBSERVABILITY, LOGGING & ERROR MONITORING
# ------------------------------------------------------------------------------
# Log level: debug | info | warn | error
LOG_LEVEL="info"

# Sentry DSN for application exception tracking (backend & web)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ------------------------------------------------------------------------------
# 10. EXPO MOBILE CLIENT BUILD VARIABLES (you-are-mine-mobile)
# ------------------------------------------------------------------------------
# Passed at build time via eas.json or .env in you-are-mine-mobile
# EXPO_PUBLIC_API_URL="https://youaremine.online"
# EXPO_PUBLIC_DISTRIBUTION_CHANNEL="PLAY_STORE" # or DIRECT_APK, APP_STORE, WEB
