# ==============================================================
# YOU ARE MINE — SERVER PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================
NODE_ENV=production
PORT=3000

# Set your live public domain here (e.g. https://www.youaremine.online)
NEXT_PUBLIC_APP_URL="https://youaremine.online"

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:REPLACE_WITH_STRONG_PASSWORD@db.youaremine.internal:5432/youaremine_prod?schema=public&sslmode=require"

# Razorpay Live Credentials
RAZORPAY_KEY_ID="rzp_live_REPLACE_WITH_ACTUAL_LIVE_KEY_ID"
RAZORPAY_KEY_SECRET="REPLACE_WITH_ACTUAL_LIVE_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="REPLACE_WITH_ACTUAL_LIVE_WEBHOOK_SECRET"

# Master Cryptographic Secrets
SESSION_SECRET="REPLACE_WITH_OPENSSL_GENERATED_64_HEX_CHAR_SECRET_KEY"
ADMIN_SECRET_KEY="REPLACE_WITH_OPENSSL_GENERATED_64_HEX_ADMIN_SECRET_KEY"
CRON_SECRET="REPLACE_WITH_OPENSSL_GENERATED_64_HEX_CRON_SECRET_KEY"

# Distributed Rate Limiting & Proxy
TRUSTED_PROXY_TYPE="auto"
ALLOW_UNTRUSTED_FORWARDED_IP="false"

# Development mock bypass (MUST BE FALSE IN PRODUCTION)
ALLOW_DEV_PAYMENT_MOCK="false"

# Distributed Redis (Upstash)
UPSTASH_REDIS_REST_URL="https://REPLACE_WITH_UPSTASH_INSTANCE.upstash.io"
UPSTASH_REDIS_REST_TOKEN="REPLACE_WITH_UPSTASH_TOKEN"

# Cloudinary
CLOUDINARY_CLOUD_NAME="you-are-mine"
CLOUDINARY_API_KEY="REPLACE_WITH_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="REPLACE_WITH_CLOUDINARY_API_SECRET"
